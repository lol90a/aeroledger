# Runtime
APP_ENV=development
RUN_MIGRATIONS=true
DATABASE_URL=postgresql://aeroledger:CHANGE_ME@localhost:5435/aeroledger
JWT_SECRET=CHANGE_ME_WITH_AT_LEAST_32_CHARACTERS
HOST=127.0.0.1
PORT=8081
RUST_LOG=info
FRONTEND_URL=http://127.0.0.1:3001
PAYMENT_VERIFICATION_MODE=manual
RECONCILIATION_INTERVAL_SECONDS=60

# Wallets
WALLET_ADDRESS_BTC=CHANGE_ME
WALLET_ADDRESS_ETH=CHANGE_ME
WALLET_ADDRESS_SOL=CHANGE_ME
WALLET_ADDRESS_USDT=CHANGE_ME
WALLET_ADDRESS_USDC=CHANGE_ME
WALLET_ADDRESS_BNB=CHANGE_ME

# Chain APIs
ETHERSCAN_API_KEY=CHANGE_ME_ETHERSCAN_API_KEY

SOLANA_RPC_URL=https://api.devnet.solana.com
BITCOIN_API_BASE=https://blockstream.info/testnet/api

# ── EVM chain identity ────────────────────────────────────────────────────────
# EIP-155 chain ids. These are served to the browser so the wallet connects to the
# same network the backend verifies against; a mismatch is how funds get sent to
# the right address on the wrong chain.
# 1 = Ethereum mainnet, 11155111 = Sepolia.
ETHEREUM_CHAIN_ID=11155111
# 56 = BSC mainnet, 97 = BSC testnet.
BSC_CHAIN_ID=97

# Required whenever a BSC route is enabled.
BSCSCAN_API_KEY=

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
# Read by the browser at build time. Public values only — never put a secret here,
# it is compiled into the bundle.
VITE_API_BASE_URL=http://127.0.0.1:8081
# NOTE: VITE_SOLANA_RPC_URL used to live here and is gone on purpose. The browser
# now takes the Solana endpoint from GET /api/payments/options, so there is no
# second setting to keep in sync with SOLANA_RPC_URL above. Having both is what
# let the checkout read balances on devnet while the backend verified on mainnet.

# ── Escrow (optional, per chain) ──────────────────────────────────────────────
# Escrow is opt-in and each chain is all-or-nothing: set every variable for a
# chain or none of them. A partial configuration refuses to start, because it
# would issue price authorizations the contract rejects for reasons no error
# message connects back to a missing variable.
#
# Both signing keys are HOT KEYS and secrets. They are rotatable without
# touching either contract's admin, which is why the contracts keep the quote
# signer separate from the owner. Generate throwaway ones for local work and
# never reuse a wallet key.

# Solana (Anchor program)
#ESCROW_PROGRAM_ID=
#ESCROW_SELLER=
#ESCROW_PAYOUT_WALLET=
#ESCROW_TREASURY=
#ESCROW_QUOTE_AUTHORITY_SEED=
# Optional; defaults to wrapped SOL.
#ESCROW_MINT=So11111111111111111111111111111111111111112

# Ethereum / BSC (Solidity contract)
#ESCROW_EVM_CONTRACT=
# Inside the EIP-712 domain: a wrong value signs for a different network.
#ESCROW_EVM_CHAIN_ID=11155111
#ESCROW_EVM_RPC_URL=
#ESCROW_EVM_SELLER=
#ESCROW_EVM_PAYOUT_WALLET=
#ESCROW_EVM_TREASURY=
#ESCROW_EVM_QUOTE_SIGNER_KEY=
# Optional; the zero address means the chain's native coin.
#ESCROW_EVM_TOKEN=0x0000000000000000000000000000000000000000
# Optional. Only lower this for a local chain: a re-org can unmake what
# `latest` already reported.
#ESCROW_EVM_BLOCK_TAG=finalized
