{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    /* Indexing an array yields `T | undefined`. This is what stops a missing
       payment option or an empty list being read as a present one. */
    "noUncheckedIndexedAccess": true,
    /* exactOptionalPropertyTypes is deliberately off: the only failures it
       produces are inside vendored shadcn/ui components passing optional Radix
       props through, so turning it on would mean patching third-party code for
       no safety gain in ours. */

    /* Path alias mirrors vite.config.ts */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },

    "types": ["vite/client"]
  },
  "include": ["src"]
}
